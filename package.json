{
  "name": "playwright-scaffolder",
  "version": "1.0.0",
  "description": "An opinionated CLI for scaffolding maintainable Playwright test projects",
  "homepage": "https://github.com/tim-tom-88/playwright-scaffolder#readme",
  "bugs": {
    "url": "https://github.com/tim-tom-88/playwright-scaffolder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-tom-88/playwright-scaffolder.git"
  },
  "license": "MIT",
  "author": "Tom Hodgson",
  "type": "commonjs",
  "main": "dist/cli/index.js",
  "bin": "dist/cli/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "playwright",
    "testing",
    "scaffolding",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "test": "npm run build && node --test test/*.test.js",
    "test:unit": "npm run build && node --test test/unit.test.js",
    "test:integration": "npm run build && node --test test/integration.test.js",
    "test:e2e": "npm run build && node --test test/e2e.test.js",
    "prepublishOnly": "npm test",
    "start": "node dist/cli/index.js",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0"
  }
}
